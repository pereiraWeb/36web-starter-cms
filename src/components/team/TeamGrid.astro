---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CardProfile from '../cards/CardProfile.astro';
import { team, teamContent } from '../../config/teamContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	members?: Array<{ name: string; role: string; bio?: string; image?: string; nameField?: string; roleField?: string; bioField?: string; imageField?: string }>;
	titleField?: string;
}

const {
	eyebrow = teamContent.grid.eyebrow,
	title = teamContent.grid.title,
	description = teamContent.grid.description,
	backgroundColor,
	backgroundImage,
	titleField,
} = Astro.props;

const members = (Astro.props.members ?? team) as NonNullable<Props['members']>;

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="team-grid" style={style}>
	<Container>
		<div class="team-grid__header">
			<SectionHeading eyebrow={eyebrow} title={title} description={description} titleField={titleField} />
		</div>
		<ul class="team-grid__list">
			{members.map((member) => (
				<li>
					<CardProfile
						name={member.name}
						role={member.role}
						bio={member.bio}
						image={member.image}
						nameField={member.nameField}
						roleField={member.roleField}
						bioField={member.bioField}
						imageField={member.imageField}
					/>
				</li>
			))}
		</ul>
	</Container>
</section>

<style>
	.team-grid__header {
		max-width: 640px;
		margin-bottom: var(--spacing-lg);
	}


	.team-grid__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--spacing-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
