---
import { business } from '../../config/business';
import type { BusinessSocialLinks } from '../../config/business';

/**
 * Site-wide `Organization` JSON-LD, identifying the publisher behind every
 * page. Rendered once, globally, by `BusinessLayout.astro`.
 */
export interface Props {
	name?: string;
	legalName?: string;
	description?: string;
	email?: string;
	phone?: string;
	logo?: string;
	social?: BusinessSocialLinks;
}

const {
	name = business.name,
	legalName = business.legalName,
	description = business.description,
	email = business.email,
	phone = business.phone,
	logo = business.logo,
	social = business.social,
} = Astro.props;

const sameAs = Object.values(social).filter((url): url is string => Boolean(url));

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name,
	legalName,
	url: business.siteUrl,
	logo: logo ? new URL(logo, business.siteUrl).toString() : undefined,
	description,
	email,
	telephone: phone,
	...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
