---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CardTestimonial from '../cards/CardTestimonial.astro';
import { testimonials, testimonialsContent } from '../../config/testimonialsContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	items?: Array<{ quote: string; author: string; role?: string; avatar?: string; rating?: number; quoteField?: string; authorField?: string; roleField?: string }>;
	titleField?: string;
}

const {
	eyebrow = testimonialsContent.grid.eyebrow,
	title = testimonialsContent.grid.title,
	description = testimonialsContent.grid.description,
	backgroundColor,
	backgroundImage,
	titleField,
} = Astro.props;

const items = (Astro.props.items ?? testimonials) as NonNullable<Props['items']>;

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="testimonials-grid" style={style}>
	<Container>
		<div class="testimonials-grid__header">
			<SectionHeading eyebrow={eyebrow} title={title} description={description} titleField={titleField} />
		</div>
		<ul class="testimonials-grid__list">
			{items.map((testimonial) => (
				<li>
					<CardTestimonial
						quote={testimonial.quote}
						author={testimonial.author}
						role={testimonial.role}
						avatar={testimonial.avatar}
						rating={testimonial.rating}
						quoteField={testimonial.quoteField}
						authorField={testimonial.authorField}
						roleField={testimonial.roleField}
					/>
				</li>
			))}
		</ul>
	</Container>
</section>

<style>
	.testimonials-grid__header {
		max-width: 640px;
		margin-bottom: var(--spacing-lg);
	}


	.testimonials-grid__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--spacing-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
