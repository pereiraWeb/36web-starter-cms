---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CardBasic from '../cards/CardBasic.astro';
import { services, servicesContent, getServiceHref, type Service } from '../../config/servicesContent';
import { backgroundStyle, type BackgroundProps } from '../../lib/background';

export interface Props extends BackgroundProps {
	eyebrow?: string;
	title?: string;
	description?: string;
	/** Replaces the shared config list. The home page passes the published services. */
	items?: Array<Service & { titleField?: string; descriptionField?: string }>;
	titleField?: string;
}

const {
	eyebrow = servicesContent.grid.eyebrow,
	title = servicesContent.grid.title,
	description = servicesContent.grid.description,
	backgroundColor,
	backgroundImage,
	titleField,
} = Astro.props;

const items = (Astro.props.items ?? services) as NonNullable<Props['items']>;

const style = backgroundStyle({ backgroundColor, backgroundImage });
---

<section class="services-grid" style={style}>
	<Container>
		<div class="services-grid__header">
			<SectionHeading
				eyebrow={eyebrow}
				title={title}
				description={description}
				titleField={titleField}
			/>
		</div>
		<ul class="services-grid__list">
			{items.map((service) => (
				<li>
					<CardBasic
						title={service.title}
						description={service.description}
						href={getServiceHref(service)}
						titleField={service.titleField}
						descriptionField={service.descriptionField}
					/>
				</li>
			))}
		</ul>
	</Container>
</section>

<style>
	.services-grid__header {
		max-width: 640px;
		margin-bottom: var(--spacing-lg);
	}

	.services-grid__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-md);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
