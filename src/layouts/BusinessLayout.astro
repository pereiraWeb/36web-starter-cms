---
import SkipLink from '../components/ui/SkipLink.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import SeoHead from '../components/ui/SeoHead.astro';
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SiteHeader from '../components/tina/SiteHeader.astro';
import SiteFooter from '../components/tina/SiteFooter.astro';
import { business } from '../config/business';
import { getSiteContent } from '../lib/content/site';
import { islands } from '../lib/tina/islands';
import type { SeoProps } from '../lib/seo';
import '../styles/tokens.css';
import '../styles/global.css';

/**
 * Base layout for every real page (SEO head, header, footer, cookie
 * consent, WhatsApp/back-to-top buttons, analytics boot). Swap the header
 * or footer variant per-page — without touching this file — via the
 * `header`/`footer` named slots, e.g.:
 *
 * ```astro
 * <BusinessLayout title="...">
 *   <HeaderCta slot="header" />
 *   <FooterCta slot="footer" />
 *   ...page content...
 * </BusinessLayout>
 * ```
 *
 * Omit either slot to keep the defaults below (`HeaderSimple`/`FooterColumns`).
 */
export interface Props extends SeoProps {}

const site = await getSiteContent();
const seoProps = {
	...Astro.props,
	siteName: Astro.props.siteName ?? site.name,
	siteDescription: Astro.props.siteDescription ?? site.description,
};
---

<html lang={business.language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<SeoHead {...seoProps} />
		<OrganizationSchema
			name={site.name}
			legalName={site.legalName}
			description={site.description}
			email={site.email}
			phone={site.phone}
			logo={site.logo}
			social={site.social}
		/>
	</head>
	<body>
		<SkipLink />
		{Astro.slots.has('header') ? (
			<slot name="header" />
		) : (
			<TinaIsland name="site-header" wrapper={islands['site-header'].wrapper}>
				<SiteHeader site={site} />
			</TinaIsland>
		)}
		<main id="main-content">
			<slot />
		</main>
		{Astro.slots.has('footer') ? (
			<slot name="footer" />
		) : (
			<TinaIsland name="site-footer" wrapper={islands['site-footer'].wrapper}>
				<SiteFooter site={site} />
			</TinaIsland>
		)}
		<BackToTop />

		<script>
			import { initAnalytics } from '../lib/analytics';
			import { initImageFallbacks } from '../lib/imageFallback';

			function boot() {
				if (document.documentElement.dataset.analyticsInit) return;
				document.documentElement.dataset.analyticsInit = 'true';
				initAnalytics();
				initImageFallbacks();
			}

			document.addEventListener('DOMContentLoaded', boot);
			document.addEventListener('astro:page-load', boot);
		</script>
	</body>
</html>
