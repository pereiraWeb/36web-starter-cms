---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ServicePage from '../../components/tina/ServicePage.astro';
import { getServicePage } from '../../lib/content/pages';
import { getServiceRoutes } from '../../lib/content/services';
import { islands } from '../../lib/tina/islands';

export async function getStaticPaths() {
	const routes = await getServiceRoutes();
	return routes.map((route) => ({
		params: { slug: route.slug },
	}));
}

const slug = Astro.params.slug ?? '';
const page = await getServicePage(slug);
---
<ServiceLayout service={page.editorial.service} servicesLabel="Services">
	<TinaIsland name="service" wrapper={islands.service.wrapper} params={{ slug }} primary>
		<ServicePage data={page} />
	</TinaIsland>
</ServiceLayout>
