---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ThankYouPage from '../components/tina/ThankYouPage.astro';
import { islands } from '../lib/tina/islands';
import { getContactPage } from '../lib/content/pages';

const contact = await getContactPage();
const thanks = contact.document.thanks!;
---

<BusinessLayout title={thanks.title} description={thanks.description} noindex>
	<TinaIsland name="thanks" wrapper={islands.thanks.wrapper} primary>
		<ThankYouPage data={contact} />
	</TinaIsland>
</BusinessLayout>
