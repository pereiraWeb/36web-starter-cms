---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import AboutPage from '../components/tina/AboutPage.astro';
import { islands } from '../lib/tina/islands';
import { getAboutPage } from '../lib/content/pages';

const about = await getAboutPage();
---

<BusinessLayout title={about.document.seoTitle} description={about.document.seoDescription}>
	<TinaIsland name="about" wrapper={islands.about.wrapper} primary>
		<AboutPage data={about} />
	</TinaIsland>
</BusinessLayout>
