---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import FaqSchema from '../components/seo/FaqSchema.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ServicesIndex from '../components/tina/ServicesIndex.astro';
import { islands } from '../lib/tina/islands';
import { getServicesIndex } from '../lib/content/pages';

const services = await getServicesIndex();
---

<BusinessLayout title={services.document.seoTitle} description={services.document.seoDescription}>
	<TinaIsland name="services" wrapper={islands.services.wrapper} primary>
		<ServicesIndex data={services} />
	</TinaIsland>
	<FaqSchema items={services.faqs.map((item) => ({ question: item.question, answer: item.answer }))} />
</BusinessLayout>
