---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import LocalBusinessSchema from '../components/seo/LocalBusinessSchema.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HomePage from '../components/tina/HomePage.astro';
import { islands } from '../lib/tina/islands';
import { getHomePage } from '../lib/content/pages';
import { getSiteContent } from '../lib/content/site';

const home = await getHomePage();
const site = await getSiteContent();
---

<BusinessLayout title={home.document.seoTitle} description={home.document.seoDescription}>
	<!--
		Only meaningful for businesses with a real physical location customers
		visit — if this is a purely online business/service, delete this line
		(the site-wide `OrganizationSchema` in `BusinessLayout.astro` already
		covers general SEO identity for every business type). See
		`src/components/seo/LocalBusinessSchema.astro` for the `type` prop to
		use a more specific schema.org subtype (e.g. "Restaurant", "Dentist").
	-->
	<LocalBusinessSchema
		name={site.name}
		email={site.email}
		phone={site.phone}
		logo={site.logo}
		address={site.address}
		hours={site.hours}
	/>
	<TinaIsland name="home" wrapper={islands.home.wrapper} primary>
		<HomePage data={home} />
	</TinaIsland>
</BusinessLayout>
