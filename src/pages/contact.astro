---
import BusinessLayout from '../layouts/BusinessLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ContactPage from '../components/tina/ContactPage.astro';
import { islands } from '../lib/tina/islands';
import { getContactPage } from '../lib/content/pages';

const contact = await getContactPage();
---

<BusinessLayout title={contact.document.seoTitle} description={contact.document.seoDescription}>
	<TinaIsland name="contact" wrapper={islands.contact.wrapper} primary>
		<ContactPage data={contact} />
	</TinaIsland>
</BusinessLayout>
